<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_ticket_dte_account_move" name="Ticket Factura">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="is_dte" t-value="bool(o.dte_estado == 'PROCESADO' and o.dte_numero_control)"/>
                    <div style="font-family: 'Courier New', Courier, monospace; font-size: 11px; color: #000; background: #fff; width: 100%; padding: 4px 2px;">

                        <!-- ========== CABECERA EMPRESA ========== -->
                        <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 6px; margin-bottom: 6px;">
                            <t t-if="o.company_id.logo">
                                <img t-att-src="image_data_uri(o.company_id.logo)"
                                     style="max-width: 120px; max-height: 50px; display: block; margin: 0 auto 4px;"/>
                            </t>
                            <div style="font-size: 13px; font-weight: bold;">
                                <t t-esc="o.company_id.name.upper() if o.company_id.name else ''"/>
                            </div>
                            <t t-if="o.company_id.vat">
                                <div>NIT: <t t-esc="o.company_id.vat"/></div>
                            </t>
                            <t t-if="o.company_id.dte_nrc">
                                <div>NRC: <t t-esc="o.company_id.dte_nrc"/></div>
                            </t>
                            <t t-if="o.company_id.street">
                                <div><t t-esc="o.company_id.street"/></div>
                            </t>
                            <t t-if="o.company_id.phone">
                                <div>Tel: <t t-esc="o.company_id.phone"/></div>
                            </t>
                        </div>

                        <!-- ========== TIPO DOCUMENTO ========== -->
                        <div style="text-align: center; font-weight: bold; font-size: 12px; border: 1px solid #000; padding: 3px; margin-bottom: 6px;">
                            <t t-if="is_dte and o.doc_type_id and o.doc_type_id.name">
                                <t t-esc="o.doc_type_id.name.upper()"/>
                            </t>
                            <t t-elif="o.doc_type_id and o.doc_type_id.name">
                                <t t-esc="o.doc_type_id.name.upper()"/>
                            </t>
                            <t t-else="">
                                TICKET DE VENTA
                            </t>
                        </div>

                        <!-- ========== DATOS DOCUMENTO (DTE O NORMAL) ========== -->
                        <div style="border-bottom: 1px dashed #000; padding-bottom: 5px; margin-bottom: 5px;">
                            <t t-if="is_dte">
                                <div>
                                    <b>No. Control:</b>
                                    <t t-esc="o.dte_numero_control"/>
                                </div>
                                <t t-if="o.dte_codigo_generacion">
                                    <div style="font-size: 9px; word-break: break-all;">
                                        <b>Cod. Gen:</b>
                                        <t t-esc="o.dte_codigo_generacion"/>
                                    </div>
                                </t>
                                <div>
                                    <b>Fecha:</b>
                                    <t t-if="o.dte_fecha_hora_generacion">
                                        <span t-field="o.dte_fecha_hora_generacion"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.invoice_date"/>
                                    </t>
                                </div>
                            </t>
                            <t t-else="">
                                <div>
                                    <b>No. Factura:</b>
                                    <t t-esc="o.name"/>
                                </div>
                                <t t-if="o.invoice_date">
                                    <div>
                                        <b>Fecha:</b>
                                        <span t-field="o.invoice_date"/>
                                    </div>
                                </t>
                            </t>
                        </div>

                        <!-- ========== DATOS RECEPTOR ========== -->
                        <div style="border-bottom: 1px dashed #000; padding-bottom: 5px; margin-bottom: 5px;">
                            <div><b>Cliente:</b> <t t-esc="o.partner_id.name or ''"/></div>
                            <t t-if="o.partner_id.vat">
                                <div><b>NIT/DUI:</b> <t t-esc="o.partner_id.vat"/></div>
                            </t>
                            <t t-if="o.partner_id.street">
                                <div><t t-esc="o.partner_id.street"/></div>
                            </t>
                            <t t-if="o.partner_id.city">
                                <div>
                                    <t t-esc="o.partner_id.city"/>
                                    <t t-if="o.partner_id.state_id">, <t t-esc="o.partner_id.state_id.name"/></t>
                                </div>
                            </t>
                            <t t-if="o.partner_id.phone">
                                <div><b>Tel:</b> <t t-esc="o.partner_id.phone"/></div>
                            </t>
                        </div>

                        <!-- ========== LÍNEAS DE FACTURA ========== -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 5px; font-size: 10px;">
                            <thead>
                                <tr style="border-bottom: 1px solid #000;">
                                    <th style="text-align: left; padding: 2px 1px; width: 10%;">Cant</th>
                                    <th style="text-align: left; padding: 2px 1px; width: 55%;">Descripción</th>
                                    <th style="text-align: right; padding: 2px 1px; width: 15%;">P.Unit</th>
                                    <th style="text-align: right; padding: 2px 1px; width: 20%;">SubTotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))" t-as="line">
                                    <tr>
                                        <td style="text-align: left; padding: 2px 1px; vertical-align: top;">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td style="text-align: left; padding: 2px 1px; vertical-align: top; word-break: break-word;">
                                            <t t-esc="line.name or line.product_id.name or ''"/>
                                        </td>
                                        <td style="text-align: right; padding: 2px 1px; vertical-align: top;">
                                            <span t-field="line.price_unit"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="text-align: right; padding: 2px 1px; vertical-align: top;">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ========== TOTALES ========== -->
                        <div style="border-top: 1px solid #000; padding-top: 4px; margin-bottom: 5px;">
                            <table style="width: 100%; font-size: 11px;">
                                <tr>
                                    <td style="text-align: right; padding: 1px 3px;">Subtotal:</td>
                                    <td style="text-align: right; padding: 1px 0; width: 38%;">
                                        <span t-field="o.amount_untaxed"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-if="o.amount_tax">
                                    <tr>
                                        <td style="text-align: right; padding: 1px 3px;">IVA:</td>
                                        <td style="text-align: right; padding: 1px 0;">
                                            <span t-field="o.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr style="font-weight: bold; font-size: 13px; border-top: 1px solid #000;">
                                    <td style="text-align: right; padding: 2px 3px;">TOTAL:</td>
                                    <td style="text-align: right; padding: 2px 0;">
                                        <span t-field="o.amount_total"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- ========== CONDICIÓN / PLAZO DE PAGO ========== -->
                        <t t-if="o.dte_condicion_operacion or o.dte_forma_pago_id or o.invoice_payment_term_id">
                            <div style="border-top: 1px dashed #000; padding-top: 4px; margin-bottom: 5px; font-size: 10px;">
                                <t t-if="o.dte_condicion_operacion">
                                    <div><b>Condición:</b> <span t-field="o.dte_condicion_operacion"/></div>
                                </t>
                                <t t-elif="o.invoice_payment_term_id">
                                    <div><b>Términos de Pago:</b> <t t-esc="o.invoice_payment_term_id.name"/></div>
                                </t>
                                <t t-if="o.dte_forma_pago_id">
                                    <div><b>Forma de pago:</b> <t t-esc="o.dte_forma_pago_id.name or ''"/></div>
                                </t>
                            </div>
                        </t>

                        <!-- ========== CÓDIGO QR DTE (SOLO SI ES DTE) ========== -->
                        <t t-if="is_dte and o.dte_qr_image_sv">
                            <div style="text-align: center; margin: 6px 0; border-top: 1px dashed #000; padding-top: 5px;">
                                <img t-att-src="image_data_uri(o.dte_qr_image_sv)"
                                     style="width: 100px; height: 100px; margin: 0 auto; display: block;"/>
                                <div style="font-size: 9px; margin-top: 2px;">
                                    Escanea para verificar DTE en Hacienda
                                </div>
                            </div>
                        </t>

                        <!-- ========== SELLO DE RECEPCIÓN (SOLO SI ES DTE) ========== -->
                        <t t-if="is_dte and o.dte_sello_recepcion">
                            <div style="border-top: 1px dashed #000; padding-top: 4px; margin-top: 4px; font-size: 8px; word-break: break-all; text-align: center;">
                                <div><b>Sello MH:</b></div>
                                <div><t t-esc="o.dte_sello_recepcion"/></div>
                            </div>
                        </t>

                        <!-- ========== PIE DE PÁGINA ========== -->
                        <div style="text-align: center; border-top: 2px solid #000; margin-top: 8px; padding-top: 6px; font-size: 11px;">
                            <t t-if="o.company_id.email">
                                <div><t t-esc="o.company_id.email"/></div>
                            </t>
                            <t t-if="o.company_id.website">
                                <div><t t-esc="o.company_id.website"/></div>
                            </t>
                            <div style="font-weight: bold; margin-top: 4px;">¡GRACIAS POR SU COMPRA!</div>
                        </div>

                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
